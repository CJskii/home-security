# Copy to repository root .env.live.local; chmod 600. Never commit the filled file.
# Compose pins the upstream v1.9.14 image by digest; no image was pulled by this change.
SECURITY_GATEWAY_USER=home-security
SECURITY_GATEWAY_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_SECRET
# Full private RTSP URLs; percent-encode the username/password. No fragment options.
NVR_C1_SUB_RTSP=rtsp://ENCODED_USER:ENCODED_PASSWORD@NVR_HOST:554/unicast/c1/s1/live
NVR_C2_SUB_RTSP=rtsp://ENCODED_USER:ENCODED_PASSWORD@NVR_HOST:554/unicast/c2/s1/live
