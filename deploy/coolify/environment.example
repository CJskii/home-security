# Operator/Coolify variables. Never put secrets in VITE_* variables or Git.
# Keep this example sanitized; actual values belong in protected Coolify settings.
DASHBOARD_HOST=security.example.com
LAN_IP=REPLACE_WITH_HOST_LAN_IPV4
DASHBOARD_ALLOWED_CIDRS=REPLACE_WITH_TRUSTED_CLIENT_CIDRS
COOLIFY_NETWORK=coolify
INFRASTRUCTURE_NETWORK=infrastructure-net
# Same-host migration: reviewed image tags or digests recorded in a private release manifest.
# pull_policy:never deliberately refuses unreviewed image replacement/downloads.
API_IMAGE=home-security-backend:release
RECEIVER_IMAGE=home-security-backend:release
WORKER_IMAGE=home-security-backend:release
# Copy from mode-600 .env.dashboard.local without printing them.
DASHBOARD_PASSWORD=REPLACE_WITH_EXISTING_PASSWORD
DASHBOARD_SESSION_KEY=REPLACE_ME
SECURITY_GATEWAY_USER=REPLACE_WITH_EXISTING_GATEWAY_USER
SECURITY_GATEWAY_PASSWORD=REPLACE_WITH_EXISTING_GATEWAY_PASSWORD
# Restore these runtime-only values securely from the protected role snapshot.
DATABASE_URL=postgresql://REPLACE_APP_USER:REPLACE_PASSWORD@security-db:5432/security_events
WORKER_DATABASE_URL=postgresql://REPLACE_WORKER_USER:REPLACE_PASSWORD@security-db:5432/security_events
EVENTS_TOKEN=REPLACE_EXISTING_BEARER_TOKEN
HA_HISTORY_TOKEN=REPLACE_EXISTING_SCOPED_HA_TOKEN
CAMERA_SYNC_TOKEN=REPLACE_EXISTING_RECEIVER_TOKEN
UNIVIEW_ENABLED=false
UNIVIEW_INSTALLATION_ID=REPLACE_EXISTING_INSTALLATION_UUID
UNIVIEW_NVR_IP=REPLACE_EXISTING_NVR_IP
UNIVIEW_CAMERA_MAP=REPLACE_EXISTING_CHANNEL_MAP_JSON
UNIVIEW_USERNAME=REPLACE_EXISTING_NVR_USER
UNIVIEW_PASSWORD=REPLACE_EXISTING_NVR_PASSWORD
AI_ENABLED=false
AI_MODEL=qwen3.5:4b
API_AI_MODEL=qwen3.5:4b
AI_ZONE_SELECTION_ENABLED=false
AI_BASE_URL=REPLACE_EXISTING_INTERNAL_OLLAMA_URL
AI_ENABLEMENT_CUTOFF=
AI_TIMEOUT_MS=120000
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_ACTIVATED_AT=
NOTIFICATION_AI_UPDATES_ENABLED=false
NOTIFICATION_AI_UPDATES_FROM=
NOTIFICATION_CREDENTIAL_KEY=REPLACE_EXISTING_DESTINATION_ENCRYPTION_KEY
NOTIFICATION_APPROVED_DESTINATIONS=REPLACE_EXISTING_PINNED_DESTINATION_JSON
NOTIFICATION_MEDIA_KEY=REPLACE_EXISTING_MEDIA_KEY
NOTIFICATION_MEDIA_ORIGIN=https://security.example.com
NOTIFICATION_DASHBOARD_ORIGIN=https://security.example.com
# Optional values: copy the snapshot exactly if it overrides these defaults.
LOG_LEVEL=info
METRICS_ENABLED=false
METRICS_TOKEN=
DB_POOL_MAX=5
DB_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000
UNIVIEW_SAMPLING_ENABLED=false
UNIVIEW_SAMPLE_DELAYS_MS=5000,15000
UNIVIEW_MAX_ACTIVE_WINDOWS=2
UNIVIEW_MEMORY_BYTES=64000000
UNIVIEW_PROCESSING_TIMEOUT_MS=180000
UNIVIEW_SNAPSHOT_TIMEOUT_MS=5000
UNIVIEW_REQUEST_TIMEOUT_MS=15000

# Existing native H.264 substreams. Copy exact values from protected .env.live.local.
# These contain NVR credentials and are passed only to the private gateway.
NVR_C1_SUB_RTSP=REPLACE_EXISTING_CAMERA_1_RTSP_URL
NVR_C2_SUB_RTSP=REPLACE_EXISTING_CAMERA_2_RTSP_URL
