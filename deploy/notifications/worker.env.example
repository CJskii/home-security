# TEMPLATE ONLY: no production worker/service is created by this milestone.
# Store the real file outside Git, chmod 600. Never use VITE_*.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
DATABASE_URL=postgresql://notification_worker:REPLACE@postgres:5432/security_events
UNIVIEW_INSTALLATION_ID=00000000-0000-4000-8000-000000000000
NOTIFICATION_DASHBOARD_ORIGIN=https://dashboard.example
# API and future worker must share the protected encryption key and operator pins.
# NOTIFICATION_CREDENTIAL_KEY=<separate 64 lowercase hex characters>
NOTIFICATION_APPROVED_DESTINATIONS=[]
# Explicit HTTP exception example; approve the real adapter URL before configuring.
# NOTIFICATION_APPROVED_DESTINATIONS=[{"url":"http://192.168.50.20:8123/api/webhook/home-security","address":"192.168.50.20","allowLanHttp":true}]
# Signing secret is configured once through authenticated Settings; stored encrypted.
# Legacy NOTIFICATION_WEBHOOK_URL/ADDRESS/SECRET are rejected when live is enabled.
# Required only for separately approved sender activation; future UTC cutoff.
# NOTIFICATION_ACTIVATED_AT=2026-11-01T12:00:00.000Z
# Private CA trust, never disable TLS certificate/hostname verification.
# NODE_EXTRA_CA_CERTS=/run/secrets/automation-ca.pem

# Original-image attachment links: separate key shared only with the API.
# NOTIFICATION_MEDIA_KEY=<64 lowercase hex characters>
# NOTIFICATION_MEDIA_ORIGIN=http://192.168.50.10:3000
# Scope links to exact event/image/notification IDs; 24-hour expiry, no image archive.
