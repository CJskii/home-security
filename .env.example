# Placeholder settings only. Never put real credentials into source control.
DATABASE_URL=postgresql://security:replace-me@db:5432/security_events
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SERVICE_NAME=home-security-api
LOG_LEVEL=info
EVENTS_TOKEN=
METRICS_ENABLED=false
METRICS_TOKEN=
DB_POOL_MAX=5
DB_CHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=30000
# Explicitly enabled only after approved migration/listener handover.
UNIVIEW_ENABLED=false
UNIVIEW_INSTALLATION_ID=
UNIVIEW_NVR_IP=
UNIVIEW_CAMERA_MAP={"1":"camera_1","2":"camera_2"}
UNIVIEW_BIND_IP=127.0.0.1
UNIVIEW_MAX_BODY_BYTES=32000000
UNIVIEW_MAX_IMAGES=64
UNIVIEW_MAX_IMAGE_BYTES=16000000
UNIVIEW_MAX_PIXELS=40000000
UNIVIEW_MAX_CONCURRENT_UPLOADS=2
UNIVIEW_REQUEST_TIMEOUT_MS=15000
# Isolated development Compose database only; never publish its port.
POSTGRES_USER=security
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=security_events
DEV_API_PORT=3000
STOP_GRACE_PERIOD=45s
# M1.5 receiver-local sampling; no image files or AI inference.
UNIVIEW_SAMPLING_ENABLED=false
UNIVIEW_USERNAME=
UNIVIEW_PASSWORD=
UNIVIEW_SAMPLE_DELAYS_MS=5000,15000
UNIVIEW_MAX_ACTIVE_WINDOWS=2
UNIVIEW_MEMORY_BYTES=64000000
UNIVIEW_PROCESSING_TIMEOUT_MS=30000
UNIVIEW_SNAPSHOT_TIMEOUT_MS=5000
# Optional receiver-local action enrichment, disabled by default.
AI_ENABLED=false
# Receiver-only production exclusion switch. Remains false until separately approved.
# Saved Settings proposals cannot activate this switch.
AI_ZONE_SELECTION_ENABLED=false
AI_BASE_URL=http://ollama-api:11434
AI_MODEL=qwen3.5:4b
AI_BEARER_TOKEN=
AI_ENABLEMENT_CUTOFF=
AI_TIMEOUT_MS=120000
# When enabling AI, set UNIVIEW_PROCESSING_TIMEOUT_MS=180000 (sampling stays +5/+15).

# Only enable after a separately deployed, authenticated same-origin /live gateway.
LIVE_GATEWAY_ENABLED=false

# Optional read-only dashboard sessions; configure all three together on the API.
# Development supports loopback HTTP or LAN HTTPS. Production requires same-origin HTTPS.
DASHBOARD_ORIGIN=
# Separate random password, at least 32 characters; never reuse EVENTS_TOKEN.
DASHBOARD_PASSWORD=
# 32 random bytes encoded as 64 lowercase hex characters.
DASHBOARD_SESSION_KEY=

# Separate API-to-receiver control credential, shared by those two processes only.
# Generate at least 32 random URL-safe characters; never reuse EVENTS_TOKEN.
CAMERA_SYNC_TOKEN=
# API role only; Compose sets this to its existing receiver service.
CAMERA_SYNC_OWNER_URL=

# Optional webhook Settings/Test UI. Empty defaults prohibit saving/sending.
# API-side only. Generate a separate master key with openssl rand -hex 32.
NOTIFICATION_CREDENTIAL_KEY=
NOTIFICATION_APPROVED_DESTINATIONS=[]
NOTIFICATION_DASHBOARD_ORIGIN=
# Explicit operator pin example, only after approving the actual adapter endpoint:
# NOTIFICATION_APPROVED_DESTINATIONS=[{"url":"http://192.168.50.20:8123/api/webhook/home-security","address":"192.168.50.20","allowLanHttp":true}]
# These never start a worker from the API; keep both false for manual tests.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false

# Focused notification image context, relative to the qualifying bounding-box union.
NOTIFICATION_IMAGE_CONTEXT_FACTOR=1.8
# Optional quiet AI enrichment; worker only, OFF until receiver/handset acceptance.
NOTIFICATION_AI_UPDATES_ENABLED=false
NOTIFICATION_AI_UPDATES_FROM=

# Optional dedicated read-only HA history token (32–256 URL-safe characters).
# API only; same bearer value belongs in HA secrets.yaml, never Lovelace.
HA_HISTORY_TOKEN=

# Host-only development preparation. ID from docker compose ... ps -q db.
DEV_DATABASE_CONTAINER=
# Optional explicit network name if the database has multiple networks.
DEV_DATABASE_NETWORK=
DEV_LAN_IP=

# Operator tooling; export these for guarded deployment/HA/Node-RED preparation.
DEPLOY_POSTGRES_CONTAINER=
DEPLOY_DATABASE_HOST=
HA_CONFIG_ROOT=
NODE_RED_HOME_SECURITY_FLOW_ID=
NODE_RED_PRIMARY_ACK_NODE_NAME=
NODE_RED_PRIMARY_PHONE_SERVICE=
NODE_RED_PREVIOUS_PHONE_SERVICE=
NODE_RED_SECONDARY_PHONE_SERVICE=
# Production routing/network variables are documented in deploy/coolify/environment.example.
