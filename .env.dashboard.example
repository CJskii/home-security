# Copy only if preparing manually; dev:setup creates .env.dashboard.local (mode 600).
# Database account, database name, camera mapping and NVR credentials are read server-side
# from existing .env.local. AI, receiver, metrics and production tokens are NOT inherited.
# Host-routable address from the configured PostgreSQL container's coolify network.
DEV_DATABASE_HOST=172.20.0.10
# Set this host's actual LAN IPv4 address for npm run dev:lan.
DEV_LAN_IP=
DASHBOARD_ORIGIN=http://127.0.0.1:5173
DASHBOARD_PASSWORD=REPLACE_WITH_A_SEPARATE_RANDOM_PASSWORD_AT_LEAST_32_CHARACTERS
DASHBOARD_SESSION_KEY=REPLACE_WITH_64_LOWERCASE_HEX_CHARACTERS
# Development API is fixed to 127.0.0.1:3001; PostgreSQL stays unpublished.
# npm run dev:lan selects HTTPS/LAN origin and frontend binding automatically.
# Optional local live gateway: disabled until separately provisioned.
LIVE_GATEWAY_ENABLED=false
# Match .env.live.local; these are consumed only by Vite's Node server, never VITE_*.
SECURITY_GATEWAY_USER=home-security
SECURITY_GATEWAY_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_SECRET

# Optional: after the receiver/API migration is explicitly applied and its owner
# is upgraded, enable forwarding. Never point this at an old receiver.
# Development database connections stay read-only.
CAMERA_SYNC_OWNER_URL=
CAMERA_SYNC_TOKEN=
